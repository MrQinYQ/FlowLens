  "transitions": [
    {
      "id": "start",
      "from": "overview",
      "to": "create",
      "label": "新建计划",
      "description": "从投放概览进入计划创建流程。",
      "outcome": "打开基础信息页",
      "tone": "accent"
    },
    {
      "id": "configure",
      "from": "create",
      "to": "targeting",
      "label": "下一步：配置人群",
      "requiredFields": [
        "campaignName",
        "budget"
      ],
      "condition": "计划名称和每日预算已填写",
      "rules": [
        "名称为空时停留当前页并提示。",
        "每日预算为空时阻止继续。"
      ],
      "outcome": "保留已填写内容并打开定向配置"
    },
    {
      "id": "add-creative",
      "from": "targeting",
      "to": "creative",
      "label": "下一步：添加创意",
      "description": "完成人群设置后配置广告内容。",
      "outcome": "打开创意配置页"
    },
    {
      "id": "submit",
      "from": "creative",
      "to": "review",
      "label": "提交审核",
      "requiredFields": [
        "creativeTitle",
        "landingUrl"
      ],
      "condition": "创意标题和落地页均已填写",
      "outcome": "计划进入待审核状态",
      "rules": [
        "演示不会发出网络提交请求。"
      ]
    },
    {
      "id": "approve",
      "from": "review",
      "to": "active",
      "label": "审核通过",
      "tone": "success",
      "trigger": "审核人员选择通过",
      "condition": "审核人员确认计划和创意符合要求",
      "outcome": "计划进入投放中状态"
    },
    {
      "id": "reject",
      "from": "review",
      "to": "rejected",
      "label": "驳回修改",
      "tone": "danger",
      "trigger": "审核人员选择驳回",
      "condition": "发现需修改的问题",
      "outcome": "展示原因和修改入口",
      "rules": [
        "驳回后允许修改并再次提交。"
      ]
    },
    {
      "id": "revise",
      "from": "rejected",
      "to": "creative",
      "label": "修改创意",
      "tone": "danger",
      "description": "回到创意配置，保留之前填写的信息。",
      "outcome": "修改完成后可再次提交审核"
    },
    {
      "id": "view-report",
      "from": "active",
      "to": "report",
      "label": "查看投放效果",
      "tone": "success",
      "outcome": "打开投放效果报表"
    },
    {
      "id": "back-home",
      "from": "report",
      "to": "overview",
      "label": "返回工作台",
      "outcome": "返回投放概览"
    }
  ]
}
